{
    "name": "common",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/common/src",
    "projectType": "library",
    "tags": ["scope:common"],
    "targets": {
        "build": {
            "executor": "@nx/rollup:rollup",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/libs/common",
                "main": "libs/common/src/index.ts",
                "tsConfig": "libs/common/tsconfig.lib.json",
                "project": "libs/common/package.json",
                "format": ["esm", "cjs"],
                "globals": [
                    {
                        "global": "Rx",
                        "moduleId": "rxjs"
                    },
                    {
                        "global": "Rx",
                        "moduleId": "rxjs/operators"
                    }
                ],
                "assets": [
                    {
                        "glob": "libs/common/README.md",
                        "input": ".",
                        "output": "."
                    }
                ]
            }
        },
        "publish": {
            "command": "node tools/scripts/publish.mjs common {args.ver} {args.tag}",
            "dependsOn": ["build"]
        },
        "lint": {
            "executor": "@nx/eslint:lint",
            "outputs": ["{options.outputFile}"]
        },
        "test": {
            "options": {
                "passWithNoTests": true
            },
            "configurations": {
                "ci": {
                    "ci": true,
                    "coverage": true
                }
            }
        },
        "version": {
            "executor": "@jscutlery/semver:version",
            "options": {
                "preset": "conventional",
                "commitMessageFormat": "chore(${projectName}): release version ${version}"
            }
        }
    }
}
